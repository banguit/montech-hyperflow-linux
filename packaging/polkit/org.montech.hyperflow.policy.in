<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<!-- Generated from org.montech.hyperflow.policy.in at install time.
     exec.path must be the ABSOLUTE path pkexec will invoke; polkit matches on
     it exactly, so a policy naming /usr/bin while the helper lives in
     /usr/local/bin silently refuses every request. -->
<policyconfig>
  <vendor>montech-hyperflow</vendor>
  <vendor_url>https://github.com/OWNER/montech-hyperflow-linux</vendor_url>
  <icon_name>montech-hyperflow</icon_name>

  <action id="org.montech.hyperflow.configure">
    <description>Change pump-head display settings</description>
    <message>Authentication is required to change the pump-head display settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- An active local session may keep the authorisation for the session
           rather than re-prompting on every unit/source toggle. The helper
           can only write validated keys into /etc/montech-hyperflow.conf. -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@BINDIR@/montech-hyperflow-admin</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
